<view class="wrap">

  <view wx:if="{{err}}" class="card errbox">
    <view class="errt">⚠️ 页面初始化失败</view>
    <view class="errd">{{err}}</view>
  </view>

  <view class="card hero">
    <view class="row between">
      <view>
        <view class="eyebrow">我的冰箱</view>
        <view class="big">{{total}}<text class="unit">种食材在库</text></view>
      </view>
      <view class="fam">{{members}} 人</view>
    </view>

    <view class="stats">
      <view class="st">
        <view class="si g">✓</view>
        <view class="sv g">{{counts.g}}</view>
        <view class="sl">充足</view>
      </view>
      <view class="st">
        <view class="si y">!</view>
        <view class="sv y">{{counts.y}}</view>
        <view class="sl">正常</view>
      </view>
      <view class="st">
        <view class="si p">⏱</view>
        <view class="sv p">{{counts.p}}</view>
        <view class="sl">临期</view>
      </view>
      <view class="st">
        <view class="si b">×</view>
        <view class="sv b">{{counts.b}}</view>
        <view class="sl">过期</view>
      </view>
    </view>

    <view wx:if="{{hasUrgent}}" class="alert" bindtap="onUrgent">
      <text>{{urgentText}}</text>
      <text class="go">去看看 ›</text>
    </view>
  </view>

  <view class="btn primary op" bindtap="onShoot">📷 拍照入库</view>

  <view class="chips">
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="{{item.cls}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{foods.length}}">
    <view
      wx:for="{{foods}}"
      wx:key="id"
      class="{{item.cls}}"
      data-id="{{item.id}}"
      bindtap="onFood"
    >
      <view class="fico">{{item.emoji}}</view>
      <view class="fmain">
        <view class="fname">{{item.name}}</view>
        <view class="fqty">{{item.qty}}</view>
      </view>
      <view class="fright">
        <view class="{{item.pillCls}}">{{item.tierWord}}</view>
        <view class="fday {{item.dayCls}}">{{item.day}}</view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="e">🧺</view>
    <view>这里空空的</view>
    <view class="muted">点上面的「拍照入库」开始</view>
  </view>

</view>
