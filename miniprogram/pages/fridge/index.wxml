<view class="wrap">

  <view wx:if="{{err}}" class="card errbox">
    <view class="errt">⚠️ 页面初始化失败</view>
    <view class="errd">{{err}}</view>
  </view>

  <!-- 顶部总览 -->
  <view class="hero">
    <view class="row between">
      <view>
        <view class="eyebrow">{{dateText}} · 我的冰箱</view>
        <view class="h1">{{name}}的冰箱</view>
      </view>
      <view class="fam">{{members}} 人</view>
    </view>

    <view class="ringwrap">
      <canvas type="2d" id="ring" class="ringcv"></canvas>
      <view class="ringc">
        <view class="ringn">{{total}}</view>
        <view class="ringl">种食材在库</view>
      </view>
    </view>

    <view class="{{freshCls}}">{{freshText}}</view>

    <view class="stats">
      <view class="st">
        <view class="si g">✓</view><view class="sv g">{{counts.g}}</view><view class="sl">充足</view>
      </view>
      <view class="st">
        <view class="si y">!</view><view class="sv y">{{counts.y}}</view><view class="sl">正常</view>
      </view>
      <view class="st">
        <view class="si p">⏱</view><view class="sv p">{{counts.p}}</view><view class="sl">临期</view>
      </view>
      <view class="st">
        <view class="si b">×</view><view class="sv b">{{counts.b}}</view><view class="sl">过期</view>
      </view>
    </view>

    <view wx:if="{{hasUrgent}}" class="alert" bindtap="onUrgent">
      <text>{{urgentText}}</text>
      <text class="go">去看看 ›</text>
    </view>
  </view>

  <!-- AI 营养对对碰 -->
  <view wx:if="{{hasAI}}" class="ai">
    <view class="row between">
      <text class="aitag">✨ AI 营养对对碰</text>
      <text class="aiswap" bindtap="onShuffleAI">换一组 ↻</text>
    </view>
    <view class="aipair">{{aiA}} + {{aiB}}</view>
    <view class="aiwhy">{{aiWhy}}</view>
    <view class="row between airow">
      <view class="aitags"><text>相生搭配</text><text>冰箱里有</text></view>
      <view class="aigo" bindtap="onAIDish">看教程 →</view>
    </view>
  </view>

  <!-- 今天的菜单 -->
  <view class="sec">
    <view class="bar2"></view>
    <view class="t">今天的菜单</view>
    <text class="more" bindtap="onGen">换一换 ›</text>
  </view>
  <view wx:if="{{hasMenu}}" class="card menucard">
    <view wx:for="{{meals}}" wx:key="slot" class="meal">
      <view class="slot">{{item.slot}}</view>
      <view class="mnames">{{item.names}}</view>
    </view>
  </view>
  <view wx:else class="card menucard">
    <view class="muted">还没排今天的菜，按家庭档案生成一下</view>
    <view class="btn primary gen" bindtap="onGen">生成今天的菜单</view>
  </view>

  <!-- 操作 -->
  <view class="btn primary shoot" bindtap="onShoot">📷 拍照入库</view>

  <!-- 筛选 -->
  <view class="chips">
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="{{item.cls}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </view>

  <!-- 食材列表 -->
  <view wx:if="{{foods.length}}">
    <view
      wx:for="{{foods}}"
      wx:key="id"
      class="{{item.cls}}"
      data-id="{{item.id}}"
      bindtap="onFood"
    >
      <view class="fico">{{item.emoji}}</view>
      <view class="fmain">
        <view class="fname">{{item.name}}</view>
        <view class="fqty">{{item.qty}}</view>
      </view>
      <view class="fright">
        <view class="{{item.pillCls}}">{{item.tierWord}}</view>
        <view class="fday {{item.dayCls}}">{{item.day}}</view>
      </view>
    </view>
  </view>
  <view wx:else class="empty">
    <view class="e">🧺</view>
    <view>这里空空的</view>
    <view class="muted">点上面的「拍照入库」开始</view>
  </view>

</view>
