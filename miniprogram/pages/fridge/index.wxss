.hero {
  background: linear-gradient(170deg, #FFFFFF, #F2FCF7);
  border-radius: 36rpx;
}
.eyebrow { font-size: 24rpx; font-weight: 800; color: #12A576; letter-spacing: 1rpx; }
.big { font-size: 76rpx; font-weight: 800; line-height: 1.1; letter-spacing: -2rpx; }
.big .unit { font-size: 24rpx; font-weight: 700; color: #7C8B87; margin-left: 12rpx; letter-spacing: 0; }
.fam {
  font-size: 24rpx; font-weight: 700; color: #0E7A5A;
  background: #EAFBF2; border: 1rpx solid #CBEFE0;
  padding: 10rpx 20rpx; border-radius: 22rpx;
}

.stats { display: flex; margin-top: 26rpx; }
.st {
  flex: 1; text-align: center; background: #F7FBF9;
  border: 1rpx solid #EAF3EE; border-radius: 24rpx;
  padding: 16rpx 0 14rpx; margin-right: 12rpx;
}
.st:last-child { margin-right: 0; }
.si {
  width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%;
  color: #fff; font-size: 22rpx; font-weight: 800; margin: 0 auto 8rpx;
}
.si.g { background: #35C77E } .si.y { background: #F5B301 }
.si.p { background: #9B6BF5 } .si.b { background: #9AA3AF }
.sv { font-size: 34rpx; font-weight: 800; }
.sl { font-size: 20rpx; color: #7C8B87; font-weight: 700; margin-top: 4rpx; }

.alert {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding: 20rpx 22rpx; border-radius: 22rpx;
  background: linear-gradient(100deg, #F7F1FF, #FDF7FF);
  border: 1rpx solid #EADFFF;
  font-size: 24rpx; font-weight: 700; color: #4B3A6B;
}
.alert .go { color: #6D28D9; font-weight: 800; }

.ops { margin: 8rpx 0 18rpx; }
.op { flex: 1; }

.filters { white-space: nowrap; margin-bottom: 6rpx; }

.food {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #EDF3F0; border-radius: 30rpx;
  padding: 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx -16rpx rgba(20, 60, 45, .6);
  position: relative; overflow: hidden;
}
.food::before {
  content: ''; position: absolute; left: 0; top: 22rpx; bottom: 22rpx;
  width: 6rpx; border-radius: 0 6rpx 6rpx 0;
}
.food.g::before { background: #35C77E } .food.y::before { background: #F5B301 }
.food.p::before { background: #9B6BF5 } .food.b::before { background: #9AA3AF }
.food.p { box-shadow: 0 0 0 3rpx rgba(155, 107, 245, .16); }

.fico {
  width: 88rpx; height: 88rpx; border-radius: 26rpx; font-size: 42rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6FBF8; border: 1rpx solid #EDF3F0; margin-right: 22rpx;
}
.fmain { flex: 1; min-width: 0; }
.fname { font-size: 30rpx; font-weight: 800; }
.fqty { font-size: 22rpx; color: #8B9A96; margin-top: 6rpx; }
.fright { text-align: right; }
.fday { font-size: 22rpx; font-weight: 700; margin-top: 8rpx; }
