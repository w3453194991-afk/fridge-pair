.hero {
  background: linear-gradient(170deg, #FFFFFF, #F2FCF7);
  border: 1rpx solid #E7F3EC;
  border-radius: 40rpx;
  padding: 30rpx 30rpx 26rpx;
  box-shadow: 0 12rpx 34rpx -22rpx rgba(18, 120, 90, .45);
}
.eyebrow { font-size: 24rpx; font-weight: 800; color: #12A576; letter-spacing: 1rpx; }
.h1 { font-size: 40rpx; font-weight: 800; margin-top: 6rpx; }
.fam {
  font-size: 24rpx; font-weight: 700; color: #0E7A5A;
  background: #EAFBF2; border: 1rpx solid #CBEFE0;
  padding: 10rpx 20rpx; border-radius: 22rpx;
}

.ringwrap {
  position: relative; width: 300rpx; height: 300rpx;
  margin: 24rpx auto 18rpx;
}
.ringcv { width: 300rpx; height: 300rpx; }
.ringc {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ringn { font-size: 76rpx; font-weight: 800; line-height: 1; letter-spacing: -2rpx; }
.ringl { font-size: 22rpx; color: #7C8B87; font-weight: 700; margin-top: 8rpx; }

.fresh {
  margin: 0 auto; width: fit-content; text-align: center;
  font-size: 22rpx; font-weight: 800;
  padding: 12rpx 26rpx; border-radius: 30rpx;
}
.fresh.ok { color: #0E8F63; background: #E6FAF1; }
.fresh.warn { color: #6D28D9; background: #F3EBFF; }

.stats { display: flex; margin-top: 26rpx; }
.st {
  flex: 1; text-align: center; background: #F7FBF9;
  border: 1rpx solid #EAF3EE; border-radius: 24rpx;
  padding: 16rpx 0 14rpx; margin-right: 12rpx;
}
.st:last-child { margin-right: 0; }
.si {
  width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%;
  color: #fff; font-size: 22rpx; font-weight: 800; margin: 0 auto 8rpx;
}
.si.g { background: #35C77E } .si.y { background: #F5B301 }
.si.p { background: #9B6BF5 } .si.b { background: #9AA3AF }
.sv { font-size: 34rpx; font-weight: 800; }
.sl { font-size: 20rpx; color: #7C8B87; font-weight: 700; margin-top: 4rpx; }

.alert {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 22rpx;
  background: linear-gradient(100deg, #F7F1FF, #FDF7FF);
  border: 1rpx solid #EADFFF;
  font-size: 23rpx; font-weight: 700; color: #4B3A6B;
}
.alert .go { color: #6D28D9; font-weight: 800; }

/* AI 卡 */
.ai {
  margin-top: 22rpx; border-radius: 34rpx; padding: 26rpx 28rpx 24rpx;
  background: linear-gradient(126deg, #37D9A4, #14B98A 55%, #0E9E8C);
  box-shadow: 0 16rpx 34rpx -18rpx rgba(16, 150, 120, .8);
  color: #fff;
}
.aitag { font-size: 22rpx; font-weight: 800; opacity: .95; }
.aiswap { font-size: 21rpx; opacity: .9; }
.aipair { font-size: 42rpx; font-weight: 900; margin: 16rpx 0 10rpx; letter-spacing: 1rpx; }
.aiwhy { font-size: 22rpx; line-height: 1.6; opacity: .95; }
.airow { margin-top: 20rpx; }
.aitags text {
  font-size: 19rpx; font-weight: 700;
  background: rgba(255, 255, 255, .22); border-radius: 10rpx;
  padding: 6rpx 14rpx; margin-right: 10rpx;
}
.aigo {
  font-size: 23rpx; font-weight: 800; color: #0E8F63;
  background: #fff; border-radius: 24rpx; padding: 10rpx 24rpx;
}

/* 今日菜单 */
.menucard { padding: 10rpx 24rpx; }
.meal { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #F2F7F4; }
.meal:first-child { border-top: 0; }
.slot {
  width: 52rpx; height: 44rpx; border-radius: 12rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; font-weight: 800; color: #0E8F63; background: #E6FAF1;
  margin-right: 18rpx;
}
.mnames { flex: 1; font-size: 25rpx; line-height: 1.6; }
.gen { margin-top: 18rpx; height: 80rpx; font-size: 27rpx; }
.more { font-size: 22rpx; color: #12A576; font-weight: 700; margin-left: auto; }

.shoot { margin: 22rpx 0 6rpx; }

.food {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #EDF3F0; border-radius: 30rpx;
  padding: 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx -16rpx rgba(20, 60, 45, .6);
  position: relative; overflow: hidden;
}
.food::before {
  content: ''; position: absolute; left: 0; top: 22rpx; bottom: 22rpx;
  width: 6rpx; border-radius: 0 6rpx 6rpx 0;
}
.food.g::before { background: #35C77E } .food.y::before { background: #F5B301 }
.food.p::before { background: #9B6BF5 } .food.b::before { background: #9AA3AF }
.food.p { box-shadow: 0 0 0 3rpx rgba(155, 107, 245, .16); }

.fico {
  width: 88rpx; height: 88rpx; border-radius: 26rpx; font-size: 42rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6FBF8; border: 1rpx solid #EDF3F0; margin-right: 22rpx;
}
.fmain { flex: 1; min-width: 0; }
.fname { font-size: 30rpx; font-weight: 800; }
.fqty { font-size: 22rpx; color: #8B9A96; margin-top: 6rpx; }
.fright { text-align: right; }
.fday { font-size: 22rpx; font-weight: 700; margin-top: 8rpx; }

.errbox { background: #FFF6F6; border-color: #F6D6D6; }
.errt { font-size: 30rpx; font-weight: 800; color: #B91C1C; margin-bottom: 12rpx; }
.errd { font-size: 24rpx; color: #8A4B4B; line-height: 1.7; word-break: break-all; }

.quickrow { display: flex; margin: 22rpx 0 6rpx; }
.quick {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 24rpx;
  font-size: 25rpx; font-weight: 800; color: #0E8F63;
  background: #EAFBF2; border: 1rpx solid #CBEFE0;
}
.quick:first-child { margin-right: 16rpx; }
.quick:active { transform: scale(.97); }
