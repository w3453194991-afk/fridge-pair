<view class="wrap tabpad">

  <view class="card acct">
    <view class="av">🧑‍🍳</view>
    <view class="in">
      <view class="nm">{{famName}}</view>
      <view class="sub">{{memberCount}} 位家人 · 冰箱 {{total}} 件</view>
    </view>
  </view>

  <view class="card health">
    <view class="row between">
      <view>
        <view class="hl">冰箱健康度</view>
        <view class="hv">{{health}}<text class="hu">%</text></view>
      </view>
      <view class="hx">充足占比</view>
    </view>
    <view class="bar"><view class="fill" style="width:{{health}}%"></view></view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">家庭档案</view></view>
  <view class="card">
    <view wx:if="{{memberRows.length}}">
      <view wx:for="{{memberRows}}" wx:key="idx" class="line row between">
        <text>{{item.label}}</text>
        <text class="muted">{{item.age}}</text>
      </view>
    </view>
    <view wx:else class="muted">还没填家庭成员</view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">健康档案</view></view>
  <view class="card" bindtap="onHealth">
    <view class="line row between">
      <text>过敏原</text>
      <text class="muted">{{avoidText}}</text>
    </view>
    <view class="line row between">
      <text>疾病史</text>
      <text class="muted">{{condText}}</text>
    </view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">更多</view></view>
  <view class="card">
    <view class="line2 row between" bindtap="onChat">
      <text>🤖 问问冰箱（AI 助手）</text>
      <text class="dgo">›</text>
    </view>
    <view class="line2 row between" bindtap="onNearby">
      <text>🧭 附近超市</text>
      <text class="dgo">›</text>
    </view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">演示工具</view></view>
  <view class="card">
    <view class="line2 row between">
      <text>时间旅行 +3 天</text>
      <view class="chip" bindtap="onTravel">试试</view>
    </view>
    <view class="line2 row between">
      <text>重置示例冰箱</text>
      <view class="chip" bindtap="onReset">重置</view>
    </view>
  </view>

  <view class="about" bindtap="onAbout">冰箱对对碰 · 小程序版</view>

  <view class="logout" bindtap="onLogout">退出登录</view>

</view>
