.chatpage {
  display: flex; flex-direction: column;
  height: 100vh; background: #F4FBF7;
  padding-bottom: env(safe-area-inset-bottom);
}
.msgs { flex: 1; padding: 24rpx 26rpx 0; box-sizing: border-box; }
.msg { display: flex; margin-bottom: 20rpx; }
.msg.me { justify-content: flex-end; }
.bubble {
  max-width: 76%; font-size: 27rpx; line-height: 1.65;
  padding: 20rpx 24rpx; border-radius: 26rpx;
  background: #fff; border: 1rpx solid #E7F1EC; color: #1E322B;
  box-shadow: 0 6rpx 18rpx -16rpx rgba(16,120,90,.6);
}
.msg.me .bubble {
  background: linear-gradient(135deg, #2FD79E, #12A576); color: #fff; border: none;
}
.chips { display: flex; flex-wrap: wrap; padding: 0 26rpx 10rpx; }
.chips .chip { font-size: 22rpx; padding: 10rpx 20rpx; margin: 0 12rpx 12rpx 0; }
.inputbar {
  display: flex; align-items: center; padding: 16rpx 24rpx 20rpx;
  background: #fff; border-top: 1rpx solid #EDF3F0;
}
.inp {
  flex: 1; height: 80rpx; background: #F5FAF7; border-radius: 22rpx;
  padding: 0 24rpx; font-size: 26rpx;
}
.send {
  width: 130rpx; height: 80rpx; margin-left: 16rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #2FD79E, #12A576);
}
