.t1 { font-size: 36rpx; font-weight: 800; }
.t2 { font-size: 23rpx; color: #7C8B87; margin-top: 10rpx; line-height: 1.7; }
.lab { font-size: 24rpx; font-weight: 700; color: #33473F; margin-bottom: 12rpx; }
.q {
  background: #F5FAF7; border-radius: 20rpx; height: 84rpx;
  padding: 0 22rpx; font-size: 28rpx;
}
.plats { display: flex; margin-top: 6rpx; }
.plat {
  flex: 1; height: 96rpx; border-radius: 24rpx; margin-right: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 25rpx; font-weight: 800; color: #12232B;
  background: #F3FBF7; border: 1rpx solid #DFF0E7;
}
.plat:last-child { margin-right: 0; }
.plat:active { transform: scale(.97); }
.mt { margin-top: 22rpx; }

.tip { background: linear-gradient(120deg, #F7F1FF, #FDF7FF); border-color: #EADFFF; }
.tipt { font-size: 26rpx; font-weight: 800; color: #5B3FA8; }
.tipc { font-size: 22rpx; color: #7A6B96; line-height: 1.75; margin-top: 10rpx; }
