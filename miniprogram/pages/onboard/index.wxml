<view class="onb">

  <view class="top">
    <view class="dots">
      <view class="dot {{step >= 0 ? 'on' : ''}}"></view>
      <view class="dot {{step >= 1 ? 'on' : ''}}"></view>
      <view class="dot {{step >= 2 ? 'on' : ''}}"></view>
    </view>
    <view class="skip" bindtap="onSkip">跳过</view>
  </view>

  <!-- 第 1 步：几口人 -->
  <block wx:if="{{step == 0}}">
    <view class="title">你家有几口人？</view>
    <view class="sub">按每个人的年龄安排菜量和口味</view>

    <view class="members">
      <view wx:for="{{members}}" wx:key="index" class="mrow">
        <view class="mleft">
          <view class="mico">{{item.icon}}</view>
          <view class="mrole" data-i="{{index}}" bindtap="cycleRole">{{item.role}}<text class="mchange">点击切换</text></view>
        </view>
        <view class="mright">
          <view class="qb" data-i="{{index}}" data-d="-1" bindtap="changeAge">−</view>
          <text class="age">{{item.age}} 岁</text>
          <view class="qb" data-i="{{index}}" data-d="1" bindtap="changeAge">+</view>
        </view>
      </view>
    </view>

    <view class="addrow">
      <view class="addbtn" bindtap="addMember">＋ 加一位</view>
      <view wx:if="{{members.length > 1}}" class="delbtn" bindtap="removeMember">− 减少</view>
    </view>
  </block>

  <!-- 第 2 步：忌口 -->
  <block wx:if="{{step == 1}}">
    <view class="title">有忌口或过敏吗？</view>
    <view class="sub">选中的之后不会再给你推荐含它的菜</view>
    <view class="chips">
      <view
        wx:for="{{allergens}}"
        wx:key="name"
        class="{{item.on ? 'chip on' : 'chip'}}"
        data-i="{{index}}"
        bindtap="toggleAllergen"
      >{{item.name}}</view>
    </view>
    <view class="note">没有就点「下一步」，之后也能在「我的」里改</view>
  </block>

  <!-- 第 3 步：疾病史 -->
  <block wx:if="{{step == 2}}">
    <view class="title">有需要注意的健康情况吗？</view>
    <view class="sub">会用来调整油盐和食材，仅供参考</view>
    <view class="condlist">
      <view
        wx:for="{{condList}}"
        wx:key="key"
        class="conditem {{item.on ? 'on' : ''}}"
        data-i="{{index}}"
        bindtap="toggleCond"
      >
        <view class="condicon">{{item.icon}}</view>
        <view class="condbody">
          <view class="condname">{{item.name}}</view>
          <view class="condnote">{{item.note}}</view>
        </view>
        <view class="condck">{{item.on ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="title2">平时爱吃什么口味？</view>
    <view class="chips">
      <view
        wx:for="{{systems}}"
        wx:key="key"
        class="{{item.cls}}"
        data-key="{{item.key}}"
        bindtap="pickSystem"
      >{{item.label}}</view>
    </view>
  </block>

  <view class="spacer"></view>

  <view class="bottom">
    <view wx:if="{{step > 0}}" class="btn ghost" bindtap="prev">上一步</view>
    <view class="btn primary" bindtap="next">{{step == 2 ? '开始使用' : '下一步'}}</view>
  </view>

</view>
