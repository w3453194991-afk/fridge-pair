<view class="wrap">

  <view class="tabs">
    <view class="{{tab == 'pending' ? 'tab on' : 'tab'}}" data-tab="pending" bindtap="onTab">视频待审</view>
    <view class="{{tab == 'dishes' ? 'tab on' : 'tab'}}" data-tab="dishes" bindtap="onTab">菜谱待审</view>
    <view class="{{tab == 'photos' ? 'tab on' : 'tab'}}" data-tab="photos" bindtap="onTab">实拍图</view>
    <view class="{{tab == 'images' ? 'tab on' : 'tab'}}" data-tab="images" bindtap="onTab">评论图片</view>
    <view class="{{tab == 'all' ? 'tab on' : 'tab'}}" data-tab="all" bindtap="onTab">全部视频</view>
  </view>

  <view wx:if="{{loading}}" class="state">
    <view class="spin"></view>
    <view class="stxt">加载中…</view>
  </view>

  <view wx:elif="{{err}}" class="card errcard">
    <view class="etxt">{{err}}</view>
    <view class="ehint">需要管理员权限：在云函数 videos 的环境变量里配置 ADMIN_OPENIDS（你的 openid），保存后重新部署 videos。其他函数会自动向 videos 询问，不需要重复配置。</view>
    <view class="btn ghost mt" bindtap="onDiag">🔍 诊断（看真实 openid）</view>
    <view class="btn ghost mt" bindtap="onBack">返回</view>
  </view>

  <block wx:elif="{{rows.length}}">
    <view wx:for="{{rows}}" wx:key="id" class="card row">
      <view class="rtop">
        <view class="rname">{{item.title}}</view>
        <view class="rstat {{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="rmeta">{{item.dishName}} · {{item.atText}}</view>

      <view wx:if="{{item.isDish}}" class="dishinfo">
        <view class="dline">食材：{{item.ings || '未填写'}}</view>
        <view class="dline">做法：{{item.steps}} 步</view>
      </view>

      <view wx:if="{{(item.isImage || item.isPhoto) && item.images.length}}" class="cmshots">
        <image
          wx:for="{{item.images}}" wx:for-item="im" wx:for-index="ii" wx:key="*this"
          class="cmshot" src="{{im}}" mode="aspectFill"
          data-id="{{item.id}}" data-i="{{ii}}" bindtap="onPreviewCmImg"
        />
      </view>

      <view class="rbtns">
        <view wx:if="{{!item.isImage && !item.isDish}}" class="btnmini ghost" data-i="{{index}}" bindtap="onPlay">预览</view>
        <view wx:if="{{item.status == 'pending' || item.status == 'blocked'}}" class="btnmini primary" data-i="{{index}}" bindtap="onApprove">通过</view>
        <view wx:if="{{item.status == 'pending' || item.status == 'ok'}}" class="btnmini danger" data-i="{{index}}" bindtap="onBlock">驳回</view>
      </view>
    </view>
  </block>

  <view wx:else class="state">
    <view class="e">✅</view>
    <view class="stxt">{{tab == 'pending' ? '没有待审核的视频' : (tab == 'images' ? '没有待审核的评论图片' : '还没有任何视频')}}</view>
  </view>

  <view class="note">只有 ADMIN_OPENIDS 里的账号能进这个页面</view>

</view>
