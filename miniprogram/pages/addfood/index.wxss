.addpage { padding-bottom: 180rpx; }

.hero { padding: 10rpx 4rpx 22rpx; }
.ht { font-size: 42rpx; font-weight: 900; }
.hs { font-size: 23rpx; color: #8B9A96; margin-top: 8rpx; }

.field {
  display: flex; align-items: center;
  background: #fff; border: 2rpx solid #CBEFE0; border-radius: 24rpx;
  padding: 0 22rpx; height: 96rpx;
}
.lab { font-size: 23rpx; font-weight: 700; color: #5E7D71; margin-bottom: 10rpx; }
.mt { margin-top: 28rpx; }
.inp { flex: 1; font-size: 30rpx; font-weight: 700; margin-left: 16rpx; }
.inp.small { font-size: 26rpx; font-weight: 600; margin-left: 0; background: #F5FAF7; border-radius: 16rpx; padding: 0 18rpx; height: 76rpx; }

.matched {
  font-size: 21rpx; color: #0E8F63; background: #EAFBF2;
  border-radius: 16rpx; padding: 12rpx 18rpx; margin-top: 14rpx;
}
.sug { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.sugitem {
  font-size: 23rpx; color: #22332C; background: #fff;
  border: 1rpx solid #E7EFEA; border-radius: 18rpx;
  padding: 12rpx 20rpx; margin: 0 12rpx 12rpx 0;
}

.row2 { display: flex; margin-top: 26rpx; }
.half { flex: 1; }
.half:first-child { margin-right: 20rpx; }
.stepper { display: flex; align-items: center; background: #fff; border: 1rpx solid #E7EFEA; border-radius: 20rpx; height: 76rpx; padding: 0 10rpx; }
.qb {
  width: 56rpx; height: 56rpx; border-radius: 16rpx; text-align: center; line-height: 56rpx;
  background: #EAFBF2; color: #0E8F63; font-size: 32rpx; font-weight: 800;
}
.qn { flex: 1; text-align: center; font-size: 30rpx; font-weight: 800; }

.segrow { display: flex; background: #EFF5F2; border-radius: 20rpx; padding: 6rpx; margin-bottom: 18rpx; }
.seg {
  flex: 1; text-align: center; font-size: 24rpx; font-weight: 700; color: #6C7F78;
  padding: 16rpx 0; border-radius: 16rpx;
}
.seg.on { background: #fff; color: #0E8F63; box-shadow: 0 4rpx 10rpx -6rpx rgba(16,120,90,.5); }

.datebox {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #E7EFEA; border-radius: 20rpx;
  padding: 0 22rpx; height: 92rpx;
}
.dicon { font-size: 30rpx; margin-right: 14rpx; }
.dval { flex: 1; font-size: 30rpx; font-weight: 800; }
.dgo { font-size: 21rpx; color: #9AA6A1; }

.addnow { margin-top: 30rpx; }

.bottom {
  position: fixed; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 92rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 800; color: #0E8F63;
  background: #fff; border: 1rpx solid #CBEFE0;
  box-shadow: 0 10rpx 24rpx -14rpx rgba(16,120,90,.6);
}
.bottomspace { height: 50rpx; }
