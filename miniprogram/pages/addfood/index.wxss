.addpage { padding-bottom: 160rpx; }

.searchbar {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #E7EFEA; border-radius: 24rpx;
  padding: 0 20rpx; height: 84rpx; margin-bottom: 16rpx;
}
.mag { font-size: 28rpx; opacity: .55; margin-right: 12rpx; }
.sinput { flex: 1; font-size: 26rpx; }
.clear {
  width: 44rpx; height: 44rpx; border-radius: 50%; text-align: center; line-height: 44rpx;
  color: #7C8B87; background: #F1F7F4; font-size: 22rpx;
}

.cats { margin-bottom: 10rpx; }
.cats .chip { font-size: 22rpx; padding: 12rpx 22rpx; margin: 0 12rpx 12rpx 0; }

.list { margin-top: 4rpx; }
.row {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #EDF3F0; border-radius: 24rpx;
  padding: 18rpx 20rpx; margin-bottom: 14rpx;
}
.emo {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; font-size: 36rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6FBF8; margin-right: 16rpx;
}
.mid { flex: 1; min-width: 0; }
.nm { font-size: 27rpx; font-weight: 800; }
.sub { font-size: 19rpx; color: #9AA6A1; margin-top: 4rpx; }

.stepper { display: flex; align-items: center; margin-right: 14rpx; }
.qb {
  width: 48rpx; height: 48rpx; border-radius: 14rpx; text-align: center; line-height: 48rpx;
  background: #EAFBF2; color: #0E8F63; font-size: 28rpx; font-weight: 800;
}
.qn { min-width: 54rpx; text-align: center; font-size: 26rpx; font-weight: 800; }

.addbtn {
  font-size: 23rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #2FD79E, #12A576);
  border-radius: 18rpx; padding: 14rpx 24rpx;
}

.bottom {
  position: fixed; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 92rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 800; color: #0E8F63;
  background: #fff; border: 1rpx solid #CBEFE0;
  box-shadow: 0 10rpx 24rpx -14rpx rgba(16,120,90,.6);
}
.bottomspace { height: 40rpx; }
