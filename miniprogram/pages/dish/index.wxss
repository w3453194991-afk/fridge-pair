.hero { text-align: center; padding: 36rpx 28rpx 30rpx; }
.hem { font-size: 96rpx; line-height: 1; }
.hname { font-size: 40rpx; font-weight: 800; margin-top: 14rpx; }
.hmeta { font-size: 24rpx; color: #7C8B87; margin-top: 10rpx; }
.htags { font-size: 22rpx; color: #0E8F63; margin-top: 10rpx; }

.line { padding: 18rpx 0; border-bottom: 1rpx solid #F2F7F4; font-size: 27rpx; }
.line:last-child { border-bottom: 0; }
.need { color: #7C8B87; margin-right: 16rpx; font-size: 24rpx; }

.season { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.tg {
  font-size: 21rpx; color: #54786A; background: #F2F9F5;
  border-radius: 10rpx; padding: 8rpx 16rpx; margin: 8rpx 10rpx 0 0;
}

.step { display: flex; padding: 14rpx 0; }
.no {
  width: 44rpx; height: 44rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #3FDCA4, #12A576);
  margin-right: 18rpx;
}
.no.ghost { background: #D8EFE4; color: #4E7A6A; }
.tx { flex: 1; font-size: 26rpx; line-height: 1.7; color: #22322C; }
.heat {
  font-size: 20rpx; font-weight: 800; color: #0E8F63;
  background: #E6FAF1; border-radius: 8rpx; padding: 3rpx 10rpx; margin-right: 8rpx;
}
.btns { margin-top: 16rpx; }

.heroimg {
  width: 100%; height: 340rpx; border-radius: 32rpx; margin-bottom: 20rpx;
  background: #EAF7F1;
}

.mt { margin-top: 18rpx; }

.iname { font-size: 27rpx; font-weight: 600; }
.speakall {
  margin-left: auto; font-size: 21rpx; font-weight: 800; color: #0E8F63;
  background: #EAFBF2; border: 1rpx solid #CBEFE0; border-radius: 18rpx; padding: 8rpx 20rpx;
}
.steptools { display: flex; margin-top: 10rpx; }
.tool {
  font-size: 20rpx; font-weight: 700; color: #54786A;
  background: #F3FAF6; border: 1rpx solid #E4F1EA; border-radius: 14rpx;
  padding: 8rpx 18rpx; margin-right: 12rpx;
}
.btn-hover { opacity: .85; transform: scale(.99); }
.bottomspace { height: 60rpx; }

/* ---------- 朗读模式覆盖层 ---------- */
.reader {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200;
  background: linear-gradient(170deg, #F7FDFA, #EAF7F1);
  display: flex; flex-direction: column;
  padding: 60rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
}
.rd-top { display: flex; align-items: center; justify-content: space-between; }
.rd-name { font-size: 30rpx; font-weight: 800; color: #0E8F63; }
.rd-close { font-size: 36rpx; color: #9AA6A1; padding: 0 12rpx; }

.rd-progress { height: 10rpx; background: #E4F1EA; border-radius: 6rpx; margin: 26rpx 0 10rpx; overflow: hidden; }
.rd-fill { height: 100%; background: linear-gradient(90deg, #3FDCA4, #12A576); border-radius: 6rpx; transition: width .3s; }

.rd-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.rd-tag {
  font-size: 24rpx; font-weight: 800; color: #0E8F63;
  background: #E6FAF1; border-radius: 16rpx; padding: 8rpx 20rpx;
  width: fit-content; margin-bottom: 26rpx;
}
.rd-text {
  font-size: 52rpx; line-height: 1.55; font-weight: 800; color: #12232B;
  letter-spacing: 1rpx;
}

.rd-ctrls { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 20rpx; }
.rd-btn {
  flex: 1; height: 100rpx; border-radius: 26rpx; margin: 0 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 800; color: #4E6B61;
  background: #fff; border: 1rpx solid #DFF0E7;
}
.rd-btn.main { color: #fff; background: linear-gradient(135deg, #2FD79E, #12A576); border: none; flex: 1.4; }

.rd-bottom { display: flex; flex-direction: column; align-items: center; }
.rd-speed {
  font-size: 24rpx; font-weight: 700; color: #0E8F63;
  background: #EAFBF2; border-radius: 22rpx; padding: 12rpx 28rpx;
}
.rd-hint { font-size: 20rpx; color: #9AA6A1; margin-top: 16rpx; }

/* ---------- 做菜三步：拍照 / 识别 / 结果 ---------- */
.cookmask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 210;
  background: rgba(6, 24, 18, .92);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.scanimg { width: 520rpx; height: 520rpx; border-radius: 28rpx; opacity: .9; }
.scanline {
  position: absolute; left: 50%; transform: translateX(-50%);
  width: 520rpx; height: 6rpx; border-radius: 4rpx;
  background: linear-gradient(90deg, transparent, #7DEBFF, transparent);
  box-shadow: 0 0 24rpx #7DEBFF;
  animation: scanmove 1.4s ease-in-out infinite;
}
@keyframes scanmove {
  0% { top: 44%; opacity: .2; }
  50% { top: 72%; opacity: 1; }
  100% { top: 44%; opacity: .2; }
}
.scantip { position: absolute; bottom: 28%; color: #9BF3FF; font-size: 26rpx; font-weight: 700; }

.cookpanel {
  width: 640rpx; max-height: 88vh; background: #fff; border-radius: 34rpx;
  padding: 26rpx; display: flex; flex-direction: column;
}
.cookphoto { width: 100%; height: 260rpx; border-radius: 22rpx; }
.cooktitle { font-size: 32rpx; font-weight: 800; margin-top: 18rpx; }
.cooksub { font-size: 21rpx; color: #8B9A96; margin-top: 6rpx; }
.cooklist { flex: 1; margin-top: 16rpx; max-height: 46vh; }
.cookitem { padding: 16rpx 0; border-top: 1rpx solid #F2F7F4; }
.cookitem:first-child { border-top: 0; }
.ci-top { display: flex; align-items: center; justify-content: space-between; }
.ci-n { font-size: 26rpx; font-weight: 700; }
.ci-left { font-size: 24rpx; font-weight: 800; color: #12A576; }
.ci-scale { display: flex; justify-content: space-between; font-size: 19rpx; color: #9AA6A1; margin-top: -6rpx; }

.cookbtns { display: flex; margin-top: 20rpx; }
.cookbtns .btn { flex: 1; margin-right: 16rpx; }
.cookbtns .btn:last-child { margin-right: 0; }
.cookcancel { text-align: center; font-size: 22rpx; color: #9AA6A1; margin-top: 18rpx; }

.buycard { border-color: #FBE3CF; background: linear-gradient(120deg,#FFF9F2,#FFFFFF); }
.btitle { font-size: 27rpx; font-weight: 800; color: #B45309; }
.buybtn {
  font-size: 21rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg,#FF9A5A,#FF6B3D);
  border-radius: 18rpx; padding: 10rpx 20rpx;
}
.buyitem { display: flex; align-items: center; padding: 14rpx 0; border-top: 1rpx solid #F6EFE7; }
.bemo { font-size: 30rpx; margin-right: 14rpx; }
.bname { flex: 1; font-size: 26rpx; font-weight: 600; }
.bneed { font-size: 21rpx; color: #8B6B4A; margin-right: 16rpx; }
.bprice { font-size: 21rpx; color: #B45309; }

.gennotice {
  margin: 4rpx 0 18rpx; font-size: 21rpx; line-height: 1.7;
  color: #B45309; background: #FFF7E8; border: 1rpx solid #FBE3CF;
  border-radius: 18rpx; padding: 16rpx 20rpx;
}
