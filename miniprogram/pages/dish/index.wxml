<view class="wrap" wx:if="{{dish}}">

  <image wx:if="{{dish.photo}}" class="heroimg" src="{{dish.photo}}" mode="aspectFill" />

  <view class="card hero">
    <view class="hem">{{dish.emoji}}</view>
    <view class="hname">{{dish.name}}</view>
    <view class="hmeta">⏱ {{dish.minutes}} 分钟 · {{dish.level}} · {{dish.cuisine}}</view>
    <view class="htags">{{dish.tags}}</view>
  </view>

  <view wx:if="{{dish.custom}}" class="gennotice">
    ⚠️ 这道菜由系统按菜名模板生成，做法与用量仅供参考，实际以你的烹饪习惯为准。
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">食材用量</view><view class="n">{{missingCount ? ('缺 ' + missingCount + ' 样') : '都齐了'}}</view></view>
  <view class="card">
    <view wx:for="{{states}}" wx:key="name" class="line row between">
      <text class="iname">{{item.name}}</text>
      <view class="row">
        <text class="need">{{item.amount}}</text>
        <text class="{{item.pillCls}}">{{item.pillText}}</text>
      </view>
    </view>
    <view wx:if="{{dish.seasonings.length}}" class="season">
      <text wx:for="{{dish.seasonings}}" wx:key="*this" class="tg">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{missingCount}}" class="card buycard">
    <view class="row between">
      <view class="btitle">🛒 冰箱里缺这几样</view>
      <view class="buybtn" bindtap="onBuyMissing">加入采购清单</view>
    </view>
    <view wx:for="{{missing}}" wx:key="name" class="buyitem">
      <text class="bemo">{{item.emoji}}</text>
      <text class="bname">{{item.name}}</text>
      <text class="bneed">需 {{item.need}}</text>
      <text class="bprice">{{item.priceText}}</text>
    </view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">预处理</view></view>
  <view class="card">
    <view wx:for="{{prep}}" wx:key="*this" class="step">
      <view class="no ghost">{{index + 1}}</view>
      <view class="tx">{{item}}</view>
    </view>
  </view>

  <view class="sec"><view class="bar2"></view><view class="t">分步做法</view><view class="n">{{steps.length}} 步</view></view>
  <view class="card">
    <view wx:for="{{steps}}" wx:key="no" class="step">
      <view class="no">{{item.no}}</view>
      <view class="tx">
        <text wx:if="{{item.heat}}" class="heat">{{item.heat}}</text>
        {{item.text}}
      </view>
    </view>
  </view>

  <view class="btns">
    <view class="btn primary" bindtap="onCook" hover-class="btn-hover">开始做菜 · 拍照记录</view>
    <view class="btn ghost mt" bindtap="onWebRecipe" hover-class="btn-hover">🔍 网上找做法（图文）</view>
    <view class="btn ghost mt" bindtap="onVideo" hover-class="btn-hover">{{hasVideo ? '▶ 播放做法视频' : '▶ 找视频教程'}}</view>
    <view wx:if="{{!hasVideo}}" class="btn ghost mt" bindtap="onAddVideo" hover-class="btn-hover">📹 添加我的做法视频</view>
    <view wx:if="{{dish.custom}}" class="btn danger mt" bindtap="onRemove" hover-class="btn-hover">从菜谱库移除</view>
  </view>

  <view class="bottomspace"></view>

  <!-- 扫描中 -->
  <view wx:if="{{cookStep == 'scan'}}" class="cookmask">
    <image class="scanimg" src="{{photo}}" mode="aspectFill" />
    <view class="scanline"></view>
    <view class="scantip">🤖 正在识别剩余食材…</view>
  </view>

  <!-- 识别结果 -->
  <view wx:if="{{cookStep == 'result'}}" class="cookmask">
    <view class="cookpanel">
      <image class="cookphoto" src="{{photo}}" mode="aspectFill" />
      <view class="cooktitle">{{dish.name}} · 做完了</view>
      <view class="cooksub">按照照片估算的剩余量，可手动微调</view>

      <scroll-view scroll-y class="cooklist">
        <view wx:for="{{items}}" wx:key="name" class="cookitem">
          <view class="ci-top">
            <text class="ci-n">{{item.emoji}} {{item.name}}</text>
            <text class="ci-left">剩 {{item.leftTxt}}</text>
          </view>
          <slider
            value="{{item.ratio}}"
            min="0"
            max="100"
            step="5"
            activeColor="#12A576"
            backgroundColor="#EAF3EE"
            block-size="20"
            data-i="{{item.idx}}"
            bindchanging="onRatio"
            bindchange="onRatio"
          />
          <view class="ci-scale">
            <text>用光</text>
            <text>原 {{item.haveTxt}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="cookbtns">
        <view class="btn ghost" bindtap="onRetake">重拍</view>
        <view class="btn primary" bindtap="onConfirmCook">确认并更新库存</view>
      </view>
      <view class="cookcancel" bindtap="onCancelCook">先不更新</view>
    </view>
  </view>

</view>
