.t1 { font-size: 34rpx; font-weight: 800; }
.t2 { font-size: 24rpx; color: #7C8B87; margin-top: 10rpx; line-height: 1.6; }
.mt { margin-top: 20rpx; }

.row { display: flex; align-items: center; justify-content: space-between; }
.label { font-size: 26rpx; color: #7C8B87; }
.val { font-size: 26rpx; font-weight: 700; color: #12A576; }

.chips { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip {
  font-size: 23rpx; color: #0E8F63; background: #EAFBF2;
  border: 1rpx solid #CBEFE0; border-radius: 999rpx;
  padding: 8rpx 20rpx; margin: 0 14rpx 14rpx 0;
}

.note { background: linear-gradient(120deg, #F7F1FF, #FDF7FF); border-color: #EADFFF; }
.nt { font-size: 26rpx; font-weight: 800; color: #5B3FA8; }
.nc { font-size: 22rpx; color: #7A6B96; line-height: 1.85; margin-top: 10rpx; }
