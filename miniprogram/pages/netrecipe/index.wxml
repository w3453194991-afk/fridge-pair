<view class="wrap">

  <view class="searchbar">
    <text class="mag">🔍</text>
    <input class="sinput" placeholder="搜网上菜谱，如：松仁玉米" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearchTap" />
    <text class="go" bindtap="onSearchTap">搜索</text>
  </view>

  <view class="hint">加入后这道菜会出现在「菜谱」里，也能在「聚餐规划 → 想吃的菜」里点名</view>

  <view wx:if="{{loading}}" class="state">
    <view class="spin"></view>
    <view class="stxt">正在从网上取菜谱…</view>
  </view>

  <view wx:elif="{{err}}" class="card errcard">
    <view class="etxt">{{err}}</view>
    <view wx:if="{{needConfig}}" class="ehint">
      需要在云开发控制台给云函数 <text class="mono">recipes</text> 配置环境变量：
      <text class="mono">RECIPE_SOURCE</text>（juhe / tianapi / jisu）、
      <text class="mono">RECIPE_KEY</text>
    </view>
    <view class="btn ghost mt" bindtap="onBack">返回</view>
    <view class="btn primary mt" bindtap="onLocalGen">用模板生成「{{q}}」并加入</view>
  </view>

  <block wx:elif="{{items.length}}">
    <view wx:if="{{tipText}}" class="tipline">⚠️ {{tipText}}</view>
    <view wx:if="{{exactCount}}" class="okline">✅ 找到 {{exactCount}} 道名称吻合的</view>

    <view wx:for="{{items}}" wx:key="name" class="card item {{item.isRef ? 'ref' : ''}}">
      <view class="itop">
        <view class="iemo">{{item.emoji}}</view>
        <view class="imid">
          <view class="iname">
            {{item.name}}
            <text class="reltag {{item.isRef ? 'ref' : 'ok'}}">{{item.relText}}</text>
          </view>
          <view class="iing">{{item.ingredients || '主料未标注'}}</view>
          <view class="istep">{{item.stepCount}} 步 · {{item.firstStep}}</view>
        </view>
      </view>
      <view class="ibtn">
        <view class="btnmini ghost" data-i="{{index}}" bindtap="onOpen">查看</view>
        <view class="btnmini primary {{addedIdx == index ? 'done' : ''}}" data-i="{{index}}" bindtap="onAdd">
          {{addedIdx == index ? '已加入' : '加入我的菜谱'}}
        </view>
      </view>
    </view>

    <view wx:if="{{!exactCount}}" class="fallback">
      <view class="fbtxt">上面都不是「{{q}}」，要不要直接生成一份？</view>
      <view class="btn primary mt" bindtap="onLocalGen">按菜名生成「{{q}}」</view>
    </view>
  </block>

  <view wx:else class="state">
    <view class="stxt">输入菜名，搜索网上的做法</view>
  </view>

  <!-- 做法详情（站内查看，不用跳出去） -->
  <view wx:if="{{detail}}" class="mask" bindtap="onCloseDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheethead">
        <view class="shemo">{{detail.emoji}}</view>
        <view class="shmid">
          <view class="shname">{{detail.name}}</view>
          <view class="shmeta">{{detail.cuisine}} · 约 {{detail.minutes}} 分钟</view>
        </view>
        <view class="shclose" bindtap="onCloseDetail">✕</view>
      </view>

      <scroll-view scroll-y class="sheetbody">
        <view class="shsec">食材</view>
        <view class="shings">
          <text wx:for="{{detail.ingredients}}" wx:key="*this" class="shing">{{item}}</text>
        </view>

        <view wx:if="{{detail.seasonings.length}}" class="shsec">调料</view>
        <view wx:if="{{detail.seasonings.length}}" class="shings">
          <text wx:for="{{detail.seasonings}}" wx:key="*this" class="shsea">{{item}}</text>
        </view>

        <view class="shsec">做法</view>
        <view wx:for="{{detail.steps}}" wx:key="*this" class="shstep">
          <text class="shn">{{index + 1}}</text>
          <text class="sht">{{item}}</text>
        </view>

        <view wx:if="{{detail.tips.length}}" class="shsec">小贴士</view>
        <view wx:for="{{detail.tips}}" wx:key="*this" class="shtip">· {{item}}</view>

        <view class="shnote">内容来自第三方菜谱数据，仅供参考</view>
      </scroll-view>

      <view class="sheetfoot">
        <view class="btnmini ghost" bindtap="onCloseDetail">关闭</view>
        <view class="btnmini primary" bindtap="onAddFromDetail">加入我的菜谱</view>
      </view>
    </view>
  </view>

</view>
