.searchbar {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #E7EFEA; border-radius: 24rpx;
  padding: 0 20rpx; height: 88rpx;
}
.mag { font-size: 28rpx; opacity: .55; margin-right: 12rpx; }
.sinput { flex: 1; font-size: 27rpx; }
.go {
  font-size: 24rpx; font-weight: 800; color: #0E8F63;
  background: #EAFBF2; border-radius: 16rpx; padding: 10rpx 22rpx; margin-left: 10rpx;
}

.hint { font-size: 21rpx; color: #9AA6A1; margin: 16rpx 4rpx 20rpx; }

.state { margin-top: 120rpx; text-align: center; }
.spin {
  width: 56rpx; height: 56rpx; margin: 0 auto 20rpx;
  border: 5rpx solid #DFF0E7; border-top-color: #12A576; border-radius: 50%;
  animation: spin .9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.stxt { font-size: 24rpx; color: #8B9A96; }

.errcard { background: #FFF6F6; border-color: #F6D6D6; }
.etxt { font-size: 25rpx; color: #B91C1C; line-height: 1.7; word-break: break-all; }
.ehint { font-size: 21rpx; color: #8A4B4B; line-height: 1.8; margin-top: 14rpx; }
.mono { font-family: monospace; color: #B91C1C; }
.mt { margin-top: 20rpx; }

.item { padding: 22rpx 24rpx; }
.itop { display: flex; }
.iemo {
  width: 84rpx; height: 84rpx; border-radius: 24rpx; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6FBF8; margin-right: 18rpx; flex: none;
}
.imid { flex: 1; min-width: 0; }
.iname { font-size: 29rpx; font-weight: 800; }
.iing { font-size: 21rpx; color: #7C8B87; margin-top: 6rpx; }
.istep {
  font-size: 20rpx; color: #9AA6A1; margin-top: 8rpx; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.ibtn { display: flex; margin-top: 18rpx; }
.btnmini {
  flex: 1; height: 72rpx; border-radius: 20rpx; margin-right: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 800;
}
.btnmini:last-child { margin-right: 0; flex: 1.5; }
.btnmini.ghost { color: #4E6B61; background: #F5FAF7; border: 1rpx solid #E7EFEA; }
.btnmini.primary { color: #fff; background: linear-gradient(135deg, #2FD79E, #12A576); }
.btnmini.primary.done { background: #B7C4BE; }

/* 做法详情弹层 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 90;
  background: rgba(12, 32, 26, .45);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; max-height: 86vh; background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheetUp .28s ease-out both;
}
@keyframes sheetUp {
  from { transform: translateY(40rpx); opacity: .6; }
  to { transform: translateY(0); opacity: 1; }
}

.sheethead {
  display: flex; align-items: center; padding: 26rpx 26rpx 16rpx;
  border-bottom: 1rpx solid #F1F6F3;
}
.shemo {
  width: 84rpx; height: 84rpx; border-radius: 24rpx; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6FBF8; margin-right: 18rpx;
}
.shmid { flex: 1; min-width: 0; }
.shname { font-size: 32rpx; font-weight: 900; }
.shmeta { font-size: 21rpx; color: #8B9A96; margin-top: 6rpx; }
.shclose {
  width: 56rpx; height: 56rpx; border-radius: 50%; text-align: center; line-height: 56rpx;
  background: #F3F8F5; color: #7C8B87; font-size: 26rpx;
}

.sheetbody { flex: 1; padding: 8rpx 26rpx 20rpx; }

.shsec {
  font-size: 22rpx; font-weight: 900; color: #0E8F63;
  margin: 22rpx 0 12rpx; padding-left: 14rpx; position: relative;
}
.shsec::before {
  content: ''; position: absolute; left: 0; top: 4rpx; width: 6rpx; height: 22rpx;
  border-radius: 3rpx; background: #12A576;
}
.shings { display: flex; flex-wrap: wrap; }
.shing {
  font-size: 22rpx; color: #1F4738; background: #F2FAF6;
  border: 1rpx solid #DFF1E8; border-radius: 12rpx;
  padding: 8rpx 16rpx; margin: 0 10rpx 10rpx 0;
}
.shsea {
  font-size: 21rpx; color: #7A6A3C; background: #FFFAEF;
  border: 1rpx solid #F5E9CC; border-radius: 12rpx;
  padding: 8rpx 16rpx; margin: 0 10rpx 10rpx 0;
}
.shstep {
  display: flex; margin-bottom: 18rpx;
  background: #FAFDFB; border: 1rpx solid #EFF7F2; border-radius: 18rpx;
  padding: 16rpx;
}
.shn {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #12A576; color: #fff; font-size: 22rpx; font-weight: 800;
  text-align: center; line-height: 40rpx; margin-right: 14rpx;
}
.sht { flex: 1; font-size: 25rpx; line-height: 1.7; color: #21302B; }
.shtip { font-size: 22rpx; color: #8A7B4E; line-height: 1.7; margin-bottom: 8rpx; }
.shnote { font-size: 19rpx; color: #B0BCB7; text-align: center; margin: 24rpx 0 10rpx; }

.sheetfoot {
  display: flex; padding: 16rpx 26rpx 20rpx; border-top: 1rpx solid #F1F6F3;
}

.tipline {
  font-size: 22rpx; line-height: 1.7; color: #B45309;
  background: #FFF7E8; border: 1rpx solid #FBE3CF;
  border-radius: 16rpx; padding: 14rpx 18rpx; margin-bottom: 16rpx;
}
.okline {
  font-size: 22rpx; font-weight: 800; color: #0E8F63;
  background: #EAFBF2; border: 1rpx solid #CBEFE0;
  border-radius: 16rpx; padding: 12rpx 18rpx; margin-bottom: 16rpx;
}
.item.ref { opacity: .72; }
.reltag {
  font-size: 18rpx; font-weight: 800; border-radius: 8rpx;
  padding: 3rpx 10rpx; margin-left: 10rpx; vertical-align: middle;
}
.reltag.ok { color: #0E8F63; background: #E4F8EE; }
.reltag.ref { color: #9A6B3C; background: #FDF1E2; }
.fallback {
  margin: 10rpx 0 30rpx; padding: 22rpx;
  background: #F7FCF9; border: 1rpx dashed #BFE7D5; border-radius: 20rpx;
}
.fbtxt { font-size: 23rpx; color: #4E6B61; line-height: 1.6; }
