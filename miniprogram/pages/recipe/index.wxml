<view class="wrap">

  <view class="chips tabs">
    <view class="{{fitCls}}" data-tab="fit" bindtap="onTab">能做的 {{fitCount}}</view>
    <view class="{{allCls}}" data-tab="all" bindtap="onTab">全部 {{allCount}}</view>
  </view>

  <input
    class="search"
    placeholder="搜菜名或食材，如：番茄"
    value="{{q}}"
    bindinput="onSearch"
    confirm-type="search"
  />

  <view wx:if="{{list.length}}" class="cardgrid">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="dcard"
      data-id="{{item.id}}"
      bindtap="onDish"
    >
      <view class="dcoverwrap">
        <image wx:if="{{item.photo}}" class="dcover" src="{{item.photo}}" mode="aspectFill" />
        <view wx:else class="dcover fallback">{{item.emoji}}</view>
        <view wx:if="{{item.ok}}" class="dbadge">可做</view>
      </view>
      <view class="dbody">
        <view class="dname">{{item.name}}</view>
        <view class="dsub">{{item.sub}}</view>
        <view class="dmeta"><text>{{item.m1}}</text><text>{{item.m2}}</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="e">🥲</view>
    <view>暂时凑不齐一道菜</view>
    <view class="muted">去冰箱看看还差什么</view>
  </view>

</view>
