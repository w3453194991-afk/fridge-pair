.searchbar {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #E7EFEA; border-radius: 24rpx;
  padding: 0 20rpx; height: 84rpx; margin-bottom: 18rpx;
}
.mag { font-size: 28rpx; opacity: .55; margin-right: 12rpx; }
.sinput { flex: 1; font-size: 26rpx; }
.clear {
  width: 44rpx; height: 44rpx; border-radius: 50%; text-align: center; line-height: 44rpx;
  color: #7C8B87; background: #F1F7F4; font-size: 22rpx;
}

.tabs .chip { flex: 1; text-align: center; margin-right: 12rpx; }
.tabs .chip:last-child { margin-right: 0; }
.vbtn { flex: none !important; color: #0E8F63 !important; border-color: #CBEFE0 !important; }

.cardgrid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.dcard {
  width: 48.5%; margin-bottom: 20rpx; background: #fff;
  border: 1rpx solid #EDF3F0; border-radius: 26rpx; overflow: hidden;
  box-shadow: 0 6rpx 20rpx -16rpx rgba(20, 60, 45, .6);
}
.dcoverwrap { position: relative; width: 100%; height: 190rpx; background: #EAF7F1; }
.dcover { width: 100%; height: 190rpx; display: block; }
.dcover.fallback {
  display: flex; align-items: center; justify-content: center; font-size: 62rpx;
  background: linear-gradient(150deg, #EAFBF3, #D6F2E5 60%, #C9EEDD);
}
.dbadge {
  position: absolute; left: 12rpx; top: 12rpx;
  font-size: 18rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #2FD79E, #12A576);
  padding: 4rpx 12rpx; border-radius: 10rpx;
}
.dmine {
  position: absolute; left: 12rpx; bottom: 12rpx;
  font-size: 17rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #FF9A5A, #FF6B3D);
  padding: 4rpx 12rpx; border-radius: 10rpx;
}
.icorow { position: absolute; right: 10rpx; top: 10rpx; display: flex; }
.icobtn {
  width: 48rpx; height: 48rpx; border-radius: 14rpx; margin-left: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; background: rgba(255, 255, 255, .88);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .1);
}
.icobtn.on { background: #E6FAF1; }
.icobtn.cam { background: rgba(255, 255, 255, .92); }

.dbody { padding: 16rpx 18rpx 18rpx; }
.dname { font-size: 27rpx; font-weight: 800; }
.dsub {
  font-size: 20rpx; color: #8B9A96; margin-top: 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.dmeta { display: flex; margin-top: 12rpx; }
.dmeta text {
  font-size: 18rpx; color: #54786A; background: #F1F9F5;
  border: 1rpx solid #E4F1EA; border-radius: 8rpx;
  padding: 3rpx 10rpx; margin-right: 8rpx;
}


/* ---------- 列表行（用我的食材做） ---------- */
.meta1 { margin: 6rpx 0 4rpx; }
.mtext { font-size: 22rpx; color: #8B9A96; }
.addchip {
  font-size: 22rpx; font-weight: 800; color: #FF5C7A;
  background: #FFF1F4; border: 1rpx solid #FFD6DF;
  border-radius: 20rpx; padding: 10rpx 22rpx;
}
.drow {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #EDF3F0; border-radius: 28rpx;
  padding: 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx -16rpx rgba(20, 60, 45, .55);
}
.dem {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; font-size: 46rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(145deg, #EDFBF5, #DBF6EB); margin-right: 22rpx;
}
.dbd { flex: 1; min-width: 0; }
.dnm { font-size: 30rpx; font-weight: 800; display: flex; align-items: center; }
.badge {
  font-size: 18rpx; font-weight: 800; color: #0E8F63;
  background: #E6FAF1; border-radius: 8rpx; padding: 3rpx 10rpx; margin-left: 12rpx;
}
.dds { font-size: 22rpx; color: #8B9A96; margin-top: 6rpx; }
.need { color: #C2410C; }
.dmt { display: flex; margin-top: 12rpx; }
.dmt text {
  font-size: 19rpx; color: #54786A; background: #F1F9F5;
  border: 1rpx solid #E4F1EA; border-radius: 8rpx;
  padding: 3rpx 10rpx; margin-right: 10rpx;
}
.rd-pin {
  width: 52rpx; height: 52rpx; border-radius: 16rpx; margin-left: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; background: #F5FAF7;
}
.rd-pin.on { background: #E6FAF1; }
.dgo { color: #C9D6D1; font-size: 34rpx; margin-left: 10rpx; }

/* 相生相克 */
.pair {
  background: #fff; border: 1rpx solid #EDF3F0; border-radius: 26rpx;
  padding: 22rpx 24rpx; margin-bottom: 16rpx;
}
.ptop { display: flex; align-items: center; justify-content: space-between; }
.pab { font-size: 28rpx; font-weight: 800; }
.ptag { font-size: 18rpx; font-weight: 800; color: #7C8B87; background: #F2F7F4; border-radius: 8rpx; padding: 3rpx 10rpx; }
.ptag.ok { color: #0E8F63; background: #E6FAF1; }
.pwhy { font-size: 22rpx; color: #7C8B87; margin-top: 8rpx; line-height: 1.6; }

/* ---------- 置顶图钉：未置顶灰色，置顶后亮绿 ---------- */
.pin-ic { position: relative; width: 26rpx; height: 28rpx; }
.pin-ic::before {
  content: ''; position: absolute; left: 2rpx; top: 0;
  width: 22rpx; height: 17rpx; border-radius: 9rpx 9rpx 3rpx 3rpx;
  background: #C9D6D1;
}
.pin-ic::after {
  content: ''; position: absolute; left: 11rpx; top: 15rpx;
  width: 4rpx; height: 13rpx; border-radius: 0 0 2rpx 2rpx;
  background: #C9D6D1;
}
.rd-pin.on, .icobtn.on { background: #E6FAF1; border: 1rpx solid #CBEFE0; }
.rd-pin.on .pin-ic::before, .rd-pin.on .pin-ic::after,
.icobtn.on .pin-ic::before, .icobtn.on .pin-ic::after {
  background: linear-gradient(180deg, #3FDCA4, #12A576);
  box-shadow: 0 2rpx 8rpx -2rpx rgba(18, 165, 118, .9);
}

.cuiScroll { width: 100%; white-space: nowrap; margin: 6rpx 0 14rpx; }
.cuiRow { display: inline-flex; }
.cuiRow .chip { margin-right: 12rpx; font-size: 22rpx; padding: 12rpx 22rpx; flex: none; }
.filterline { font-size: 22rpx; color: #12A576; font-weight: 700; margin: 0 0 14rpx 4rpx; }
