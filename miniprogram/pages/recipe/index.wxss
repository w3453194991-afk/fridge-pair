.tabs { margin-bottom: 18rpx; }
.tabs .chip { flex: 1; text-align: center; margin-right: 14rpx; }
.tabs .chip:last-child { margin-right: 0; }

.search {
  background: #fff; border: 1rpx solid #E7EFEA; border-radius: 24rpx;
  padding: 22rpx 26rpx; font-size: 26rpx; margin-bottom: 22rpx;
}

.cardgrid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
}
.dcard {
  width: 48.5%; margin-bottom: 20rpx; background: #fff;
  border: 1rpx solid #EDF3F0; border-radius: 26rpx; overflow: hidden;
  box-shadow: 0 6rpx 20rpx -16rpx rgba(20, 60, 45, .6);
}
.dcoverwrap { position: relative; width: 100%; height: 190rpx; background: #EAF7F1; }
.dcover { width: 100%; height: 190rpx; display: block; }
.dcover.fallback {
  display: flex; align-items: center; justify-content: center; font-size: 62rpx;
  background: linear-gradient(150deg, #EAFBF3, #D6F2E5 60%, #C9EEDD);
}
.dbadge {
  position: absolute; left: 12rpx; top: 12rpx;
  font-size: 18rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #2FD79E, #12A576);
  padding: 4rpx 12rpx; border-radius: 10rpx;
}
.dbody { padding: 16rpx 18rpx 18rpx; }
.dname { font-size: 27rpx; font-weight: 800; }
.dsub {
  font-size: 20rpx; color: #8B9A96; margin-top: 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.dmeta { display: flex; margin-top: 12rpx; }
.dmeta text {
  font-size: 18rpx; color: #54786A; background: #F1F9F5;
  border: 1rpx solid #E4F1EA; border-radius: 8rpx;
  padding: 3rpx 10rpx; margin-right: 8rpx;
}
