<view class="wrap">

  <view class="pagehead">
    <view class="ph-t">一周配餐</view>
    <view class="ph-s">按全家年龄结构和冰箱现状自动排菜</view>
  </view>

  <!-- 家庭档案 -->
  <view class="card">
    <view class="row between">
      <view class="ct">• 家庭档案</view>
      <view class="editbtn" bindtap="onEditFam">编辑</view>
    </view>
    <view class="mchips">
      <view wx:for="{{memberChips}}" wx:key="text" class="mchip">{{item.icon}} {{item.text}}</view>
    </view>
    <view wx:if="{{avoidText}}" class="warnline">过敏原：{{avoidText}}</view>
    <view wx:if="{{condText}}" class="warnline">疾病史：{{condText}}</view>
    <view class="healthbtn" bindtap="onHealth">🩺 健康档案（过敏原 / 疾病史）</view>
  </view>

  <!-- 餐饮体系 -->
  <view class="sec"><view class="bar2"></view><view class="t">餐饮体系</view><view class="n">决定一餐的结构</view></view>
  <view class="chips">
    <view
      wx:for="{{systems}}"
      wx:key="key"
      class="{{item.cls}}"
      data-key="{{item.key}}"
      bindtap="onSystem"
    >{{item.label}}</view>
  </view>
  <view class="card sysdesc">
    <view class="sd-t">{{sysName}}</view>
    <view class="sd-d">{{sysDesc}}</view>
    <view class="sd-s">{{sysStripe}}</view>
  </view>

  <!-- AI 生成 -->
  <view class="aicard" bindtap="onGenerate">
    <view class="row between">
      <view class="aitag">✨ AI 个性化配餐</view>
      <view class="aidays">7 天</view>
    </view>
    <view class="aititle">{{hasMenu ? '重新生成一周营养食谱' : '生成一周不重样营养食谱'}}</view>
    <view class="aisub">幼儿少盐 · 老人补钙 · 先吃临期</view>
    <view class="aibtn">{{hasMenu ? '重新生成 →' : '立即生成 →'}}</view>
  </view>

  <!-- 配餐依据 -->
  <view class="sec"><view class="bar2"></view><view class="t">配餐依据</view></view>
  <view class="card pitems">
    <view wx:for="{{advice}}" wx:key="label" class="pitem">
      <view class="pl">{{item.icon}} {{item.label}}</view>
      <view class="pr">{{item.rule}}</view>
    </view>
    <view wx:if="{{!advice.length}}" class="muted">还没填家庭成员</view>
  </view>

  <!-- 周末聚餐 -->
  <view class="sec"><view class="bar2"></view><view class="t">周末家庭聚餐</view></view>
  <view class="card">
    <view class="pt">• 一键排一桌菜</view>
    <view class="pd">AI 盘点冰箱现有食材 → 自动搭配一桌菜 + 全套教程 → 算出缺什么、买多少。</view>
    <view class="btn primary" bindtap="onParty">🎉 开启聚餐规划</view>
  </view>

  <!-- 采购清单 -->
  <view class="sec">
    <view class="bar2"></view>
    <view class="t">采购清单</view>
    <view class="n">{{cartCount}} 项</view>
    <view class="nearby" bindtap="onNearby">附近超市 ›</view>
  </view>
  <view wx:if="{{cartCount}}" class="card">
    <view wx:for="{{cart}}" wx:key="idx" class="cartitem">
      <view class="ci-l">
        <text class="ci-e">{{item.emoji}}</text>
        <text class="ci-n">{{item.name}}</text>
      </view>
      <view class="ci-r">
        <text class="ci-q">{{item.qty}}</text>
        <view class="bought" data-i="{{item.idx}}" bindtap="onBought">已购入</view>
      </view>
    </view>
    <view class="row between carttotal">
      <text>预估 <text class="ct-val">¥{{cartTotal}}</text></text>
      <view class="row">
        <text class="linkbtn" bindtap="onClearCart">清空</text>
        <view class="buyall" bindtap="onBuyAll">全部入库</view>
      </view>
    </view>
  </view>
  <view wx:else class="card">
    <view class="muted">生成菜单后，自动算出缺什么、买多少</view>
  </view>

  <!-- 菜单 -->
  <block wx:if="{{hasMenu}}">
    <view class="sec"><view class="bar2"></view><view class="t">7 天菜单</view></view>
    <view wx:for="{{days}}" wx:key="label" class="card day">
      <view class="dlabel">{{item.label}}</view>
      <view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="slot" class="meal">
        <view class="slot">{{meal.slot}}</view>
        <view class="mnames">{{meal.names}}</view>
        <view wx:if="{{meal.miss}}" class="miss">补料</view>
      </view>
    </view>

    <view wx:if="{{nutBars.length}}" class="card nut">
      <view class="ntt">这一餐的营养<text class="nts">{{todayLabel}} · 每人份</text></view>
      <view wx:for="{{nutBars}}" wx:key="label" class="nb">
        <view class="row between nbt">
          <text class="nbl">{{item.label}}</text>
          <view class="row">
            <text class="ntag" style="color:{{item.color}};background:{{item.color}}1A">{{item.tag}}</text>
            <text class="nbv">{{item.got}}<text class="nbu">/{{item.need}}{{item.unit}}</text></text>
          </view>
        </view>
        <view class="nbar"><view class="nfill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
      </view>
    </view>
  </block>

  <ai-fab />
</view>
