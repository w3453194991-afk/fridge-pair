<view class="wrap">

  <view class="card hero">
    <view class="t1">🎉 聚餐规划</view>
    <view class="t2">男女小孩分开填，按各人饭量算份量，再配菜。</view>

    <view class="crow">
      <view class="cl">
        <text class="ce">👨</text>
        <view>
          <view class="cn">男士</view>
          <view class="cs">每人 1.2 份</view>
        </view>
      </view>
      <view class="stepper">
        <view class="step" data-k="men" data-d="-1" bindtap="onStep">−</view>
        <view class="num">{{men}}</view>
        <view class="step" data-k="men" data-d="1" bindtap="onStep">+</view>
      </view>
    </view>

    <view class="crow">
      <view class="cl">
        <text class="ce">👩</text>
        <view>
          <view class="cn">女士</view>
          <view class="cs">每人 1.0 份</view>
        </view>
      </view>
      <view class="stepper">
        <view class="step" data-k="women" data-d="-1" bindtap="onStep">−</view>
        <view class="num">{{women}}</view>
        <view class="step" data-k="women" data-d="1" bindtap="onStep">+</view>
      </view>
    </view>

    <view class="crow">
      <view class="cl">
        <text class="ce">👶</text>
        <view>
          <view class="cn">小孩</view>
          <view class="cs">每人 0.6 份 · 菜会选软一点</view>
        </view>
      </view>
      <view class="stepper">
        <view class="step" data-k="kids" data-d="-1" bindtap="onStep">−</view>
        <view class="num">{{kids}}</view>
        <view class="step" data-k="kids" data-d="1" bindtap="onStep">+</view>
      </view>
    </view>

    <view class="sumline">
      共 <text class="sumN">{{total}}</text> 人 · 折合 <text class="sumN">{{portions}}</text> 人份
    </view>

    <view class="field">
      <text class="lab">预算（可选）</text>
      <input class="inp" type="digit" placeholder="如 300" value="{{budget}}" bindinput="onBudget" />
    </view>

    <view class="field">
      <text class="lab">想吃的菜（可选）</text>
      <input class="inp" placeholder="如 水煮鱼、糖醋排骨" value="{{wish}}" bindinput="onWish" />
    </view>

    <view class="lab2">菜系</view>
    <view class="chips">
      <view
        wx:for="{{cuisines}}"
        wx:key="key"
        class="{{item.cls}}"
        data-key="{{item.key}}"
        bindtap="onCuisine"
      >{{item.key}}</view>
    </view>

    <view class="btn primary gen" bindtap="onGen">生成这桌菜</view>
  </view>

  <view wx:if="{{result}}">
    <view class="card sum">
      <view class="row between">
        <view>
          <view class="stitle">{{dateText}} · {{total}} 人</view>
          <view class="ssub">男士 {{men}} · 女士 {{women}} · 小孩 {{kids}} · {{dishCount}} 道菜</view>
        </view>
        <text class="cost">约 ¥{{cost}}</text>
      </view>
      <view wx:if="{{over}}" class="warn">超出预算，建议减一两道</view>
      <view wx:if="{{droppedText}}" class="warn2">{{droppedText}}</view>
    </view>

    <view class="sec"><view class="bar2"></view><view class="t">菜单</view><view class="n">{{dishCount}} 道</view></view>
    <view wx:for="{{dishes}}" wx:key="id" class="dish" data-id="{{item.id}}" bindtap="onDish">
      <view class="dem">{{item.emoji}}</view>
      <view class="dbd">
        <view class="dnm">{{item.name}}</view>
        <view class="dds">{{item.sub}}</view>
      </view>
      <view class="dprice">¥{{item.cost}}</view>
    </view>

    <view wx:if="{{wishText}}" class="wishline">{{wishText}}</view>

    <view wx:if="{{missingCount}}" class="card buycard">
      <view class="row between">
        <view class="tt">🛒 冰箱里缺 {{missingCount}} 样</view>
        <view class="buybtn" bindtap="onBuyMissing">全部加入采购清单</view>
      </view>
      <view wx:for="{{missing}}" wx:key="name" class="shop">
        <text class="semo">{{item.emoji}}</text>
        <text class="sname">{{item.name}}</text>
        <text class="sqty">{{item.qty}}</text>
        <text class="sprice">¥{{item.cost}}</text>
      </view>
    </view>
    <view wx:else class="card">
      <view class="tt">✅ 这些菜的食材冰箱里都有</view>
    </view>

    <view class="btn ghost" bindtap="onCopy">复制这桌菜单</view>
  </view>

</view>
