page { background: #0E1A16; }
.wrap { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }

.head { display: flex; align-items: center; margin-bottom: 24rpx; }
.hemo {
  width: 76rpx; height: 76rpx; border-radius: 22rpx; font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.1); margin-right: 16rpx;
}
.hname { font-size: 30rpx; font-weight: 800; color: #fff; }
.mytag {
  margin-left: 12rpx; font-size: 18rpx; font-weight: 800;
  color: #0E1A16; background: #3FDCA4; border-radius: 8rpx; padding: 4rpx 12rpx;
}

.playerbox {
  border-radius: 24rpx; overflow: hidden;
  background: #000; box-shadow: 0 16rpx 40rpx -20rpx rgba(0,0,0,.8);
}
.player { width: 100%; height: 420rpx; background: #000; }

.state { margin-top: 120rpx; text-align: center; }
.state .e { font-size: 100rpx; margin-bottom: 16rpx; }
.stxt { font-size: 26rpx; color: #C8D6D0; margin-bottom: 14rpx; }
.shint {
  font-size: 22rpx; color: #7E918A; line-height: 1.8;
  padding: 0 40rpx; margin-bottom: 24rpx;
}
.btn {
  margin: 0 auto; width: 300rpx; height: 88rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-weight: 800; color: #0E1A16; background: #3FDCA4;
}

/* 共享库列表 */
.plist { margin-top: 32rpx; }
.ptitle {
  font-size: 22rpx; font-weight: 800; color: #7E918A;
  margin-bottom: 16rpx; letter-spacing: 1rpx;
}
.pitem {
  display: flex; align-items: center;
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx; padding: 16rpx; margin-bottom: 14rpx;
}
.pitem.on { border-color: #3FDCA4; background: rgba(63,220,164,.12); }
.pthumb {
  width: 68rpx; height: 68rpx; border-radius: 16rpx; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.08); margin-right: 16rpx;
}
.pmid { flex: 1; min-width: 0; }
.pname {
  font-size: 25rpx; font-weight: 700; color: #EAF6F0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pmeta { font-size: 19rpx; color: #7E918A; margin-top: 6rpx; }
.pplay { font-size: 26rpx; color: #3FDCA4; }
.pdel {
  font-size: 20rpx; color: #FF8A80;
  border: 1rpx solid rgba(255,138,128,.4);
  border-radius: 10rpx; padding: 6rpx 14rpx;
}

.note { margin-top: 36rpx; text-align: center; font-size: 20rpx; color: #5F746D; }
