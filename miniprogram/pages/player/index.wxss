page { background: #0E1A16; }
.wrap { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }

.head { display: flex; align-items: center; margin-bottom: 24rpx; }
.hemo {
  width: 76rpx; height: 76rpx; border-radius: 22rpx; font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.1); margin-right: 16rpx;
}
.hname { font-size: 30rpx; font-weight: 800; color: #fff; }
.mytag {
  margin-left: 12rpx; font-size: 18rpx; font-weight: 800;
  color: #0E1A16; background: #3FDCA4; border-radius: 8rpx; padding: 4rpx 12rpx;
}

.playerbox {
  border-radius: 24rpx; overflow: hidden;
  background: #000; box-shadow: 0 16rpx 40rpx -20rpx rgba(0,0,0,.8);
}
.player { width: 100%; height: 420rpx; background: #000; }

.state { margin-top: 120rpx; text-align: center; }
.state .e { font-size: 100rpx; margin-bottom: 16rpx; }
.stxt { font-size: 26rpx; color: #C8D6D0; margin-bottom: 14rpx; }
.shint {
  font-size: 22rpx; color: #7E918A; line-height: 1.8;
  padding: 0 40rpx; margin-bottom: 24rpx;
}
.btn {
  margin: 0 auto; width: 300rpx; height: 88rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-weight: 800; color: #0E1A16; background: #3FDCA4;
}

/* 共享库列表 */
.plist { margin-top: 32rpx; }
.ptitle {
  font-size: 22rpx; font-weight: 800; color: #7E918A;
  margin-bottom: 16rpx; letter-spacing: 1rpx;
}
.pitem {
  display: flex; align-items: center;
  background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx; padding: 16rpx; margin-bottom: 14rpx;
}
.pitem.on { border-color: #3FDCA4; background: rgba(63,220,164,.12); }
.pthumb {
  width: 68rpx; height: 68rpx; border-radius: 16rpx; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.08); margin-right: 16rpx;
}
.pmid { flex: 1; min-width: 0; }
.pname {
  font-size: 25rpx; font-weight: 700; color: #EAF6F0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pmeta { font-size: 19rpx; color: #7E918A; margin-top: 6rpx; }
.pplay { font-size: 26rpx; color: #3FDCA4; }
.pdel {
  font-size: 20rpx; color: #FF8A80;
  border: 1rpx solid rgba(255,138,128,.4);
  border-radius: 10rpx; padding: 6rpx 14rpx;
}

.note { margin-top: 36rpx; text-align: center; font-size: 20rpx; color: #5F746D; }

/* ---------- 弹幕 ---------- */
.dmlayer {
  position: absolute; left: 0; right: 0; top: 0; height: 300rpx;
  overflow: hidden; pointer-events: none;
}
.dmline {
  position: absolute; right: -100%; white-space: nowrap;
  font-size: 24rpx; font-weight: 800; color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.9);
  animation: dmscroll 8s linear forwards;
  padding: 4rpx 14rpx; border-radius: 20rpx;
  background: rgba(0,0,0,.28);
}
.dmline.mine { color: #7DFFD1; }
@keyframes dmscroll {
  from { transform: translateX(0); }
  to { transform: translateX(-480%); }
}

.dmbar {
  display: flex; align-items: center; margin-top: 18rpx;
  background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 20rpx; padding: 8rpx 8rpx 8rpx 20rpx;
}
.dminput { flex: 1; font-size: 24rpx; color: #EAF6F0; }
.dmsend {
  font-size: 22rpx; font-weight: 800; color: #0E1A16;
  background: #3FDCA4; border-radius: 14rpx; padding: 12rpx 24rpx;
}

/* ---------- 评论 ---------- */
.cmsec { margin-top: 34rpx; }
.cmtitle { font-size: 24rpx; font-weight: 800; color: #CFE7DD; margin-bottom: 16rpx; }
.cmcount { color: #3FDCA4; }
.dmtip { font-size: 20rpx; color: #6E857D; }
.cmempty { font-size: 22rpx; color: #6E857D; padding: 20rpx 0; }

.cmitem {
  background: rgba(255,255,255,.05); border: 1rpx solid rgba(255,255,255,.07);
  border-radius: 18rpx; padding: 16rpx; margin-bottom: 14rpx;
}
.cmhead { display: flex; align-items: center; margin-bottom: 8rpx; }
.cmnick { font-size: 22rpx; font-weight: 800; color: #9FE8C9; }
.cmtime { font-size: 18rpx; color: #6E857D; margin-left: 12rpx; }
.cmtext { font-size: 25rpx; color: #E6F2EC; line-height: 1.7; }
.cmimgs { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.cmimg { width: 150rpx; height: 150rpx; border-radius: 14rpx; margin: 0 10rpx 10rpx 0; background: #1A2B25; }
.cmfoot { font-size: 20rpx; color: #6E857D; margin-top: 8rpx; }
.cmreplies {
  margin-top: 10rpx; padding-left: 16rpx;
  border-left: 3rpx solid rgba(63,220,164,.35);
}
.cmreply { font-size: 22rpx; color: #B9CCC4; line-height: 1.7; margin-bottom: 6rpx; }
.rpnick { color: #9FE8C9; font-weight: 700; }

.replytip {
  font-size: 21rpx; color: #9FE8C9; margin-bottom: 10rpx;
  background: rgba(63,220,164,.12); border-radius: 12rpx; padding: 10rpx 16rpx;
}
.replytip .cancel { color: #FF9E9E; margin-left: 14rpx; }

.cmimgrow { display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.cmimgbox { position: relative; margin-right: 12rpx; }
.cmimgbox .cmimg { width: 120rpx; height: 120rpx; margin: 0; }
.cmimgdel {
  position: absolute; right: -8rpx; top: -8rpx;
  width: 34rpx; height: 34rpx; border-radius: 50%; text-align: center; line-height: 34rpx;
  background: rgba(0,0,0,.72); color: #fff; font-size: 20rpx;
}

.cminputbar {
  display: flex; align-items: center; margin-top: 8rpx;
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 20rpx; padding: 8rpx 8rpx 8rpx 20rpx;
}
.cminput { flex: 1; font-size: 24rpx; color: #EAF6F0; }
.cmimgbtn { font-size: 30rpx; padding: 0 16rpx; }
.cmsend {
  font-size: 22rpx; font-weight: 800; color: #0E1A16;
  background: #3FDCA4; border-radius: 14rpx; padding: 12rpx 24rpx;
}

.cmshots { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.cmshot {
  width: 160rpx; height: 160rpx; border-radius: 16rpx;
  margin: 0 12rpx 12rpx 0; background: #F3F8F5;
}
.pendingitem { opacity: .78; }
.pendsign {
  font-size: 18rpx; color: #B45309; background: #FFF3D6;
  border-radius: 8rpx; padding: 3rpx 10rpx; margin-left: 10rpx;
}

/* 发布者水印 */
.wmk {
  position: absolute; left: 18rpx; top: 18rpx; z-index: 5;
  pointer-events: none; opacity: .92;
}
.wmkbadge {
  display: inline-flex; align-items: center;
  background: rgba(0, 0, 0, .42);
  border: 1rpx solid rgba(255, 255, 255, .22);
  border-radius: 24rpx; padding: 6rpx 18rpx 6rpx 12rpx;
  backdrop-filter: blur(2px);
}
.wmkico { font-size: 20rpx; margin-right: 8rpx; }
.wmkname {
  font-size: 21rpx; font-weight: 800; color: #fff;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.6);
  max-width: 220rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.wmkline {
  margin-top: 6rpx; font-size: 17rpx; color: rgba(255,255,255,.62);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.7); letter-spacing: 1rpx;
}

.ctrlbar { display: flex; margin-top: 14rpx; }
.ctrl {
  font-size: 22rpx; font-weight: 800; color: #9FB3AA;
  background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 16rpx; padding: 10rpx 22rpx; margin-right: 12rpx;
}
.ctrl.on { color: #7DFFD1; border-color: rgba(125,255,209,.4); background: rgba(63,220,164,.14); }
.delcm { color: #FF9E9E; margin-left: 22rpx; }
