<view class="wrap">

  <view class="head">
    <view class="hemo">{{dish.emoji || '🎬'}}</view>
    <view class="hname">{{dish.name || '做法视频'}}</view>
    <view wx:if="{{mine}}" class="mytag">我的</view>
  </view>

  <view wx:if="{{src}}" class="playerbox">
    <video
      class="player"
      src="{{src}}"
      controls
      show-center-play-btn
      enable-play-gesture
      object-fit="contain"
      bindtimeupdate="onTime"
      binderror="onError"
    ></video>

    <!-- 发布者水印（审核通过后显示） -->
    <view wx:if="{{curApproved}}" class="wmk">
      <view class="wmkbadge">
        <text class="wmkico">👤</text>
        <text class="wmkname">{{curNick || '冰箱用户'}}</text>
      </view>
      <view class="wmkline">原创做法 · 请勿盗用</view>
    </view>

    <!-- 弹幕层 -->
    <view class="dmlayer" catchtap="noop">
      <view wx:for="{{dms}}" wx:key="k" class="dmline {{item.mine ? 'mine' : ''}}" style="top:{{item.top}}rpx">
        {{item.text}}
      </view>
    </view>
  </view>

  <!-- 弹幕输入 -->
  <view wx:if="{{src}}" class="dmbar">
    <input
      class="dminput"
      placeholder="发条弹幕…"
      value="{{dmInput}}"
      bindinput="onDmInput"
      confirm-type="send"
      bindconfirm="sendDm"
      maxlength="40"
    />
    <view class="dmsend" bindtap="sendDm">发送</view>
  </view>

  <view wx:elif="{{err}}" class="state">
    <view class="e">🎬</view>
    <view class="stxt">{{err}}</view>
    <view class="btn mt" bindtap="onBack">返回</view>
  </view>

  <view wx:elif="{{!loading}}" class="state">
    <view class="e">📹</view>
    <view class="stxt">共享库里还没有这道菜的视频</view>
    <view class="shint">回到菜品详情，点「📹 添加做法视频」，选「发布到共享库」就能让所有人看到。</view>
    <view class="btn mt" bindtap="onBack">返回</view>
  </view>

  <!-- 共享库列表 -->
  <view wx:if="{{list.length}}" class="plist">
    <view class="ptitle">共享做法视频 · {{list.length}} 个</view>
    <view
      wx:for="{{list}}" wx:key="id"
      class="pitem {{curIdx == index ? 'on' : ''}}"
      data-i="{{index}}" bindtap="onPick"
    >
      <view class="pthumb">🎬</view>
      <view class="pmid">
        <view class="pname">{{item.title}}</view>
        <view class="pmeta">{{item.atText}}{{item.mine ? ' · 我发布的' : ''}}</view>
      </view>
      <view wx:if="{{item.mine}}" class="pdel" data-i="{{index}}" catchtap="onRemove">删除</view>
      <view wx:else class="pplay">▶</view>
    </view>
  </view>

  <!-- 评论 -->
  <view wx:if="{{curVideoId}}" class="cmsec">
    <view class="cmtitle">
      💬 评论 <text class="cmcount">{{comments.length}}</text>
      <text class="dmtip">· 弹幕 {{dmAll.length}}</text>
    </view>

    <view wx:if="{{!comments.length}}" class="cmempty">还没有评论，来说两句</view>

    <view wx:for="{{comments}}" wx:key="id" class="cmitem {{item.pending ? 'pendingitem' : ''}}">
      <view class="cmhead">
        <text class="cmnick">{{item.nick}}</text>
        <text class="cmtime">{{item.atText}}</text>
        <text wx:if="{{item.pending}}" class="pendsign">图片审核中，仅自己可见</text>
      </view>
      <view wx:if="{{item.text}}" class="cmtext">{{item.text}}</view>
      <view wx:if="{{item.images.length}}" class="cmimgs">
        <image
          wx:for="{{item.images}}" wx:for-item="img" wx:for-index="ii" wx:key="*this"
          class="cmimg" src="{{img}}" mode="aspectFill"
          data-id="{{item.id}}" data-i="{{ii}}" bindtap="onPreviewImg"
        />
      </view>
      <view class="cmfoot">
        <text data-id="{{item.id}}" data-nick="{{item.nick}}" bindtap="onReply">回复</text>
      </view>

      <view wx:if="{{item.replies.length}}" class="cmreplies">
        <view wx:for="{{item.replies}}" wx:for-item="rp" wx:key="id" class="cmreply">
          <text class="rpnick">{{rp.nick}}</text>：{{rp.text}}
        </view>
      </view>
    </view>

    <!-- 输入区 -->
    <view wx:if="{{replyName}}" class="replytip">
      回复 {{replyName}} <text class="cancel" bindtap="cancelReply">取消</text>
    </view>

    <view wx:if="{{cmImages.length}}" class="cmimgrow">
      <view wx:for="{{cmImages}}" wx:key="*this" class="cmimgbox">
        <image class="cmimg" src="{{item}}" mode="aspectFill" />
        <view class="cmimgdel" data-i="{{index}}" bindtap="onRemoveImg">✕</view>
      </view>
    </view>

    <view class="cminputbar">
      <input
        class="cminput"
        placeholder="{{replyName ? '回复 ' + replyName : '写下你的评论…'}}"
        value="{{cmInput}}"
        bindinput="onCmInput"
        confirm-type="send"
        bindconfirm="sendCm"
        maxlength="200"
      />
      <view class="cmimgbtn" bindtap="onPickImg">🖼</view>
      <view class="cmsend" bindtap="sendCm">发送</view>
    </view>
  </view>

  <view class="note">共享视频由用户上传，仅供参考</view>


</view>
