<movable-area class="fabarea">
  <movable-view
    class="fabview"
    direction="all"
    x="{{fx}}"
    y="{{fy}}"
    damping="26"
    friction="3"
    bindchange="onMove"
    bindtap="onChat"
  >
    <view class="fab">
      <view class="glow"></view>

      <view class="bot">
        <view class="ant"><view class="antdot"></view></view>
        <view class="shell">
          <view class="face">
            <view class="eye l"></view>
            <view class="eye r"></view>
            <view class="mouth"></view>
          </view>
        </view>
        <view class="shoulder l"></view>
        <view class="shoulder r"></view>
      </view>

      <view class="online"></view>
    </view>
  </movable-view>
</movable-area>
