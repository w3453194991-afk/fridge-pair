.fabarea {
  position: fixed; right: 0; bottom: 150rpx; z-index: 60;
  width: 230rpx; height: 380rpx;
}
.fabview { width: 140rpx; height: 140rpx; }

.fab {
  position: relative;
  width: 118rpx; height: 118rpx; border-radius: 38rpx;
  background: linear-gradient(150deg, #5FE7C0 0%, #24C79A 48%, #0E9E88 100%);
  border: 4rpx solid rgba(255, 255, 255, .95);
  box-shadow:
    0 14rpx 30rpx -12rpx rgba(14, 158, 136, .75),
    0 4rpx 10rpx -4rpx rgba(0, 40, 30, .3),
    inset 0 2rpx 6rpx rgba(255, 255, 255, .5);
  display: flex; align-items: center; justify-content: center;
  animation: fabfloat 3.4s ease-in-out infinite;
}
@keyframes fabfloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-7rpx); }
}

/* 外圈光晕呼吸 */
.glow {
  position: absolute; left: -8rpx; top: -8rpx; right: -8rpx; bottom: -8rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 255, 255, .55);
  opacity: 0;
  animation: fabpulse 3.4s ease-out infinite;
}
@keyframes fabpulse {
  0% { transform: scale(.92); opacity: .55; }
  70% { transform: scale(1.16); opacity: 0; }
  100% { opacity: 0; }
}

/* ---------- 机器人 ---------- */
.bot { position: relative; width: 64rpx; height: 62rpx; }

/* 天线 */
.ant {
  position: absolute; left: 50%; top: -10rpx; transform: translateX(-50%);
  width: 3rpx; height: 10rpx; background: rgba(255, 255, 255, .9); border-radius: 2rpx;
}
.antdot {
  position: absolute; left: 50%; top: -6rpx; transform: translateX(-50%);
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #FFE27A; box-shadow: 0 0 8rpx rgba(255, 226, 122, .9);
}

/* 头部外壳 */
.shell {
  position: absolute; left: 50%; top: 2rpx; transform: translateX(-50%);
  width: 62rpx; height: 56rpx; border-radius: 20rpx;
  background: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 -3rpx 6rpx rgba(14, 158, 136, .18);
}

/* 屏幕 */
.face {
  position: relative;
  width: 50rpx; height: 42rpx; border-radius: 15rpx;
  background: linear-gradient(160deg, #24333D, #0B1419);
  display: flex; align-items: center; justify-content: center;
}

/* 眼睛（弧形发光） */
.eye {
  width: 12rpx; height: 8rpx;
  border: 4rpx solid #7DEBFF; border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  filter: drop-shadow(0 0 4rpx rgba(125, 235, 255, .95));
  margin: 0 4rpx;
  animation: fabblink 4.6s ease-in-out infinite;
}
@keyframes fabblink {
  0%, 88%, 100% { transform: scaleY(1); }
  92% { transform: scaleY(.15); }
}

/* 嘴 */
.mouth {
  position: absolute; left: 50%; bottom: 7rpx; transform: translateX(-50%);
  width: 10rpx; height: 4rpx;
  border: 3rpx solid #7DEBFF; border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  filter: drop-shadow(0 0 4rpx rgba(125, 235, 255, .9));
}

/* 两侧肩膀 */
.shoulder {
  position: absolute; bottom: -2rpx; width: 7rpx; height: 12rpx;
  border-radius: 4rpx; background: rgba(255, 255, 255, .92);
}
.shoulder.l { left: 1rpx; }
.shoulder.r { right: 1rpx; }

/* 在线小绿点 */
.online {
  position: absolute; right: 6rpx; top: 6rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: #38E27F; border: 3rpx solid #fff;
  box-shadow: 0 0 10rpx rgba(56, 226, 127, .9);
}
